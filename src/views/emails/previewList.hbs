<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Email Template Previews</title>
    <style>
      :root {
        color-scheme: light;
        --bg: #f4f1ea;
        --surface: rgba(255, 255, 255, 0.82);
        --surface-strong: #ffffff;
        --text: #1f2937;
        --muted: #6b7280;
        --line: rgba(31, 41, 55, 0.08);
        --accent: #0f766e;
        --accent-soft: rgba(15, 118, 110, 0.1);
        --shadow: 0 24px 80px rgba(15, 23, 42, 0.12);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Georgia, "Times New Roman", serif;
        color: var(--text);
        background:
          radial-gradient(circle at top left, rgba(15, 118, 110, 0.14), transparent 28%),
          radial-gradient(circle at top right, rgba(180, 83, 9, 0.12), transparent 26%),
          linear-gradient(180deg, #faf7f2 0%, var(--bg) 100%);
      }

      .page {
        width: min(1120px, calc(100% - 32px));
        margin: 0 auto;
        padding: 48px 0 56px;
      }

      .hero {
        padding: 40px;
        border: 1px solid var(--line);
        border-radius: 28px;
        background:
          linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(255,255,255,0.72) 100%);
        box-shadow: var(--shadow);
        backdrop-filter: blur(14px);
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 8px 14px;
        border-radius: 999px;
        background: var(--accent-soft);
        color: var(--accent);
        font-family: "Segoe UI", sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1 {
        margin: 18px 0 12px;
        max-width: 720px;
        font-size: clamp(2.4rem, 5vw, 4.5rem);
        line-height: 0.95;
        letter-spacing: -0.05em;
        font-weight: 700;
      }

      .subtitle {
        max-width: 640px;
        margin: 0;
        color: var(--muted);
        font-family: "Segoe UI", sans-serif;
        font-size: 16px;
        line-height: 1.75;
      }

      .meta {
        margin-top: 28px;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-radius: 18px;
        background: var(--surface-strong);
        border: 1px solid var(--line);
        box-shadow: 0 12px 32px rgba(15, 23, 42, 0.06);
        font-family: "Segoe UI", sans-serif;
      }

      .meta strong {
        font-size: 1.4rem;
        color: var(--accent);
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 18px;
        margin-top: 28px;
      }

      .card {
        display: block;
        padding: 22px;
        border-radius: 22px;
        background: var(--surface);
        border: 1px solid rgba(255, 255, 255, 0.72);
        box-shadow: 0 20px 60px rgba(15, 23, 42, 0.08);
        text-decoration: none;
        color: inherit;
        transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
        backdrop-filter: blur(12px);
      }

      .card:hover {
        transform: translateY(-3px);
        box-shadow: 0 24px 64px rgba(15, 23, 42, 0.14);
        border-color: rgba(15, 118, 110, 0.18);
      }

      .card-label {
        font-family: "Segoe UI", sans-serif;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .card-title {
        margin: 14px 0 10px;
        font-size: 1.65rem;
        line-height: 1.08;
        letter-spacing: -0.04em;
      }

      .card-copy {
        margin: 0;
        font-family: "Segoe UI", sans-serif;
        color: var(--muted);
        line-height: 1.7;
        font-size: 14px;
      }

      .card-link {
        margin-top: 18px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: "Segoe UI", sans-serif;
        font-weight: 700;
        color: var(--text);
      }

      .empty {
        margin-top: 28px;
        padding: 28px;
        border-radius: 22px;
        border: 1px dashed rgba(31, 41, 55, 0.16);
        background: rgba(255, 255, 255, 0.58);
        font-family: "Segoe UI", sans-serif;
        color: var(--muted);
      }

      @media (max-width: 640px) {
        .page { width: min(100% - 20px, 1120px); padding-top: 20px; }
        .hero { padding: 24px; border-radius: 22px; }
        .card { border-radius: 18px; }
      }
    </style>
  </head>
  <body>
    <main class="page">
      <section class="hero">
        <div class="eyebrow">Neighborly Preview Studio</div>
        <h1>Email templates, ready to inspect.</h1>
        <p class="subtitle">
          Browse the current email catalogue and open any template in a realistic browser preview.
          The list below is generated directly from the active Handlebars templates directory.
        </p>
        <div class="meta">
          <strong>{{totalTemplates}}</strong>
          <span>templates discovered in <code>src/views/emails/templates</code></span>
        </div>
      </section>

      {{#if templates.length}}
      <section class="grid" aria-label="Email templates">
        {{#each templates}}
        <a class="card" href="{{href}}">
          <div class="card-label">Template</div>
          <h2 class="card-title">{{title}}</h2>
          <p class="card-copy">
            Open a browser-rendered preview for <code>{{name}}.hbs</code> with representative content and links.
          </p>
          <div class="card-link">Preview template <span>&rarr;</span></div>
        </a>
        {{/each}}
      </section>
      {{else}}
      <section class="empty">
        No Handlebars email templates were found in <code>src/views/emails/templates</code>.
      </section>
      {{/if}}
    </main>
  </body>
</html>
