{
  "name": "solfa-scripts-api",
  "version": "1.0.0",
  "description": "API endpoints for solfa-scripts",
  "main": "src/app.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon --watch src --ext js,json --exec \"node --inspect ./src/app.js\"",
    "start": "cross-env NODE_ENV=production node ./src/app.js",
    "test": "cross-env NODE_ENV=test nyc mocha --require @babel/register --recursive --exit ./test --timeout 5000",
    "seed": "node ./src/database/seeders/index.js"
  },
  "keywords": [
    "choir",
    "solfa",
    "choir",
    "scripts",
    "solfa",
    "scripts",
    "song",
    "music"
  ],
  "author": "Francis Obetta",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.4",
    "env-var": "^7.5.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "handlebars": "^4.7.9",
    "joi": "^18.2.9",
    "joi-objectid": "^4.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2",
    "morgan": "^1.12.1",
    "nodemailer": "^10.0.12",
    "validator": "^13.15.35"
  },
  "type": "module",
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.6",
    "@babel/node": "^8.0.6",
    "@babel/plugin-transform-runtime": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-stage-2": "^7.8.3",
    "@babel/register": "^8.0.6",
    "@babel/runtime": "^8.0.5",
    "@faker-js/faker": "^10.6.0",
    "babel-eslint": "^10.1.0",
    "babel-jest": "^30.5.2",
    "chai": "^6.2.2",
    "chai-http": "^5.1.2",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2",
    "mocha": "^12.0.2",
    "nodemon": "^3.1.14",
    "nyc": "^18.0.0",
    "sinon": "^22.1.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  }
}
